{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "cto",
  "subagent_depth": 1,
  "permissions": [
    {
      "action": "edit",
      "resource": "*",
      "effect": "ask"
    },
    {
      "action": "shell",
      "resource": "*",
      "effect": "ask"
    }
  ],
  "mcp": {
    "servers": {
      "playwright": {
        "type": "local",
        "command": [
          "npx",
          "-y",
          "@playwright/mcp@latest",
          "--isolated",
          "--allowed-hosts=localhost,127.0.0.1",
          "--allowed-origins=http://localhost:5173,http://127.0.0.1:5173",
          "--console-level=warning",
          "--redact-url-params=access_token,code,session,token"
        ]
      }
    }
  }
}
